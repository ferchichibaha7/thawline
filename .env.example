# Every variable Thawline reads (spec 5.3). Copy to .env and fill in what you have.
# Nothing here is required for local development: without values, the pipeline
# and web app use the local database and keyless sources (docs/DECISIONS.md D-001).

# Canonical origin of the site. Never hardcoded.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database. Defaults point at `npm run db:start` (port 54329).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/thawline
DATABASE_URL_READONLY=postgres://thawline_readonly:readonly@127.0.0.1:54329/thawline

# Supabase auth and storage (phase 2 onwards)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the pipeline's revalidation call to the web app
REVALIDATE_SECRET=

# Sent in the bot's User-Agent; required before SEC sources (phase 2)
CONTACT_EMAIL=

# Source keys. Optional for phase 1: FRED and BLS work without them.
FRED_API_KEY=
BLS_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional LLM for evidence extraction (phase 2). Without it, moderators enter fields by hand (D-023).
ANTHROPIC_API_KEY=
EXTRACT_BACKEND=manual            # manual | ollama | anthropic
EXTRACT_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
LLM_DAILY_BUDGET_USD=2

# Email (phase 5)
RESEND_API_KEY=
